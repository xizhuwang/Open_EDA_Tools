# Local development only. Official Tiny Tapeout pin / clock constraints are
# generated by the shuttle's tt-support-tools during official hardening.
create_clock -name clk -period 20.0 [get_ports clk]
set_clock_uncertainty 0.2 [get_clocks clk]
set_input_delay -clock clk -max 2.0 [get_ports {ui_in* uio_in* ena}]
set_input_delay -clock clk -min 0.2 [get_ports {ui_in* uio_in* ena}]
set_input_transition 0.1 [get_ports {ui_in* uio_in* ena rst_n}]
set_output_delay -clock clk -max 2.0 [get_ports {uo_out* uio_out* uio_oe*}]
set_output_delay -clock clk -min 0.2 [get_ports {uo_out* uio_out* uio_oe*}]
set_load 0.02 [get_ports {uo_out* uio_out* uio_oe*}]
set_false_path -from [get_ports rst_n]
